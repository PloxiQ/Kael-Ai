# Copy this file to `.env.production` before building the static frontend.
#
# NEXT_PUBLIC_KAEL_API_URL is embedded into the JavaScript bundle at build time,
# so it must be the public HTTPS URL of the deployed FastAPI backend, without a
# trailing slash.
#
# Example:
# NEXT_PUBLIC_KAEL_API_URL=https://kael-api.onrender.com
#
# Important: `.env.local` has higher priority than `.env.production` in Next.js.
# Remove or rename `frontend/.env.local` for the production build, otherwise its
# local/LAN URL will be embedded instead.

NEXT_PUBLIC_KAEL_API_URL=https://YOUR-BACKEND.onrender.com

# Clerk publishable key from the Clerk Dashboard (API keys page).
# It starts with `pk_test_` (development) or `pk_live_` (production).
# This key is public and safe to embed in the browser bundle.
# The matching CLERK_ISSUER stays on the FastAPI backend only.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
