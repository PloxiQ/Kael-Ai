# Copy this file to `.env.production` before building the static frontend.
#
# The value is embedded into the JavaScript bundle at build time, so it must be
# the public HTTPS URL of the deployed FastAPI backend, without a trailing slash.
#
# Example:
# NEXT_PUBLIC_KAEL_API_URL=https://kael-api.onrender.com
#
# Important: `.env.local` has higher priority than `.env.production` in Next.js.
# Remove or rename `frontend/.env.local` for the production build, otherwise its
# local/LAN URL will be embedded instead.

NEXT_PUBLIC_KAEL_API_URL=https://YOUR-BACKEND.onrender.com
