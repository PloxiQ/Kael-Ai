# Clerk authentication. The frontend is a static export, so it sends a Clerk
# session token as `Authorization: Bearer <token>` and this backend verifies
# the RS256 signature against Clerk's JWKS endpoint.
#
# Clerk Frontend API URL, e.g. https://your-instance.clerk.accounts.dev
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional JWKS override for proxy setups. Leave empty normally.
CLERK_JWKS_URL=
# Comma-separated origins allowed in the token's `azp` claim.
# Falls back to KAEL_ALLOWED_ORIGINS. Localhost is accepted automatically
# outside production; in production list only the deployed frontend origin.
CLERK_AUTHORIZED_PARTIES=https://kael-ai.ct.ws

# Provider keys. Fill in the key for the provider you want to use.
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Default models (used only when the request omits "model")
OPENROUTER_MODEL=openai/gpt-4o-mini
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=llama3

# Provider endpoints and timeouts
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
# In production set this to the public InfinityFree frontend URL.
OPENROUTER_HTTP_REFERER=http://localhost:3000
OPENROUTER_APP_NAME=KAEL
OLLAMA_BASE_URL=http://localhost:11434
GROQ_TIMEOUT_SECONDS=60
OPENROUTER_TIMEOUT_SECONDS=60
OLLAMA_TIMEOUT_SECONDS=120

# CORS. Comma-separated exact origins, including scheme and port.
# Local development origins are always allowed in addition to this list.
# Example for InfinityFree:
# KAEL_ALLOWED_ORIGINS=https://kael-ai.ct.ws
KAEL_ALLOWED_ORIGINS=
# Optional regex alternative for multiple subdomains. Leave empty normally.
KAEL_ALLOWED_ORIGIN_REGEX=

# Response mode budgets
KAEL_FAST_MAX_TOKENS=512
KAEL_BALANCED_MAX_TOKENS=1024
KAEL_DEEP_MAX_TOKENS=2048

# Administrator dev-mode budget and attachment limits.
# Dev mode itself is granted by the verified Clerk role (`admin`), never by a
# client-side secret.
KAEL_DEV_MAX_TOKENS=8192
KAEL_MAX_ATTACHMENTS=6
KAEL_MAX_ATTACHMENT_BASE64_CHARS=14000000
KAEL_MAX_PDF_CHARS=30000
KAEL_MAX_TEXT_ATTACHMENT_CHARS=60000

# ---------------------------------------------------------------------------
# MCP (Model Context Protocol) connectors
# ---------------------------------------------------------------------------
# Secret used to encrypt MCP OAuth/bearer tokens in SQLite. Set a long random
# value in production, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`.
# Without it, a local `backend/data/secret.key` is generated; that file does not
# survive an ephemeral Render disk.
KAEL_SECRET_KEY=
# Directory for kael.db and the fallback key. On Render free tier this disk is
# ephemeral, so tokens must be re-authorized after a redeploy.
KAEL_DATA_DIR=
# Public backend origin used to build the OAuth redirect URI:
# https://your-service.onrender.com
KAEL_PUBLIC_API_URL=http://127.0.0.1:8000
# Optional exact redirect URI override. Must end with /api/mcp/oauth/callback.
KAEL_MCP_REDIRECT_URI=
# Public frontend origin used by the OAuth callback page.
KAEL_PUBLIC_FRONTEND_URL=http://localhost:3000
# Allow http://localhost MCP servers for local development only. Never enable
# in production; KAEL_ENV=production also forces this off.
KAEL_MCP_ALLOW_LOCAL=0
# Set to 1 only behind a trusted reverse proxy (Render) so rate limits use
# X-Forwarded-For. Leave empty when the app is directly exposed.
KAEL_TRUST_PROXY_HEADERS=
# How many rightmost X-Forwarded-For entries are added by the proxy chain.
# Render sits behind Cloudflare, so the client IP is one entry left of the
# rightmost value. Use 0 if a single proxy does not append its own address.
KAEL_XFF_TRUSTED_ENTRIES=1
# Hard request body limit. Attachment payloads are additionally validated.
KAEL_MAX_REQUEST_BYTES=25000000
